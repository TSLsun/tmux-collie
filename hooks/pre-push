#!/bin/sh
# collie: refuse to push exp/* branches; experiments stay local.
# Install per repo:
#   ln -s <plugin>/hooks/pre-push "$(git rev-parse --git-common-dir)/hooks/pre-push"
# Override once: COLLIE_ALLOW_EXP=1 git push ...
[ "${COLLIE_ALLOW_EXP:-}" = 1 ] && exit 0
while read -r local_ref _ _ _; do
  case $local_ref in
    refs/heads/exp/*)
      echo "collie: refusing to push ${local_ref#refs/heads/} (exp/* stays local; COLLIE_ALLOW_EXP=1 overrides)" >&2
      exit 1
      ;;
  esac
done
exit 0
