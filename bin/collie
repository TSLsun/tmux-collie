#!/usr/bin/env bash
# collie — herd coding agents across git worktrees in tmux.
# Bash 3.2 compatible (macOS /bin/bash): no associative arrays, no mapfile.
set -euo pipefail

VERSION=0.1.0-dev
PLUGIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
STATE_DIR=${COLLIE_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/collie}
TASKS_DIR="$STATE_DIR/tasks"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/collie"
TAB=$'\t'

die() {
  printf 'collie: %s\n' "$*" >&2
  exit 1
}

warn() { printf 'collie: %s\n' "$*" >&2; }

usage() {
  cat <<'EOF'
usage: collie <command> [args]

tasks:
  new <id> [-r repo[:branch]]... [-w workspace] [-t type] [--title text]
           [--from ref] [--todo] [--edit] [--no-window]
                      create a task: worktree per repo + tmux session
  add [<id>] -r repo[:branch]... [--from ref] [--no-window]
                      attach more repos to an existing task
  ls [-a]             list tasks: id, status, priority, session (*|-), agent, repos, next
  show [<id>]         task fields, repos, agent runs and recent events
  go [<id>]           switch to the task session (fzf picker if omitted);
                      outside tmux and not a tty, print the primary worktree path
  done [<id>] [--force]     accept: remove worktrees + session, keep branches
  archive [<id>] [--force]  abandon: same cleanup, status archived

agents:
  run [<id>] [--agent name] [-r repo] [-p prompt] [-- args]
                      start an agent in a new task window (default agent:
                      $COLLIE_AGENT, @collie-agent, else claude); -p '' = no prompt
  state <working|waiting|idle|exited>
                      called by agent hooks; no-op outside a collie window
  status              agent counts for the status bar (#{collie_status})

discovery:
  repos               repos found under @collie-repo-roots / $COLLIE_REPO_ROOTS
  workspaces          named repo sets from ~/.config/collie/workspaces

<id> is a slug ([a-z0-9-], max 40). Omitted <id> falls back to $COLLIE_TASK.
<repo> is a discovered repo name or a path. Default branch: <type>/<id>, type=feat.
EOF
}

# --- repos ------------------------------------------------------------------

# Sets R_COMMON (git common dir), R_ROOT (worktree parent), R_NAME for a dir.
repo_at() {
  R_COMMON=$(git -C "$1" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || return 1
  if [ "$(git config --file "$R_COMMON/config" --bool core.bare 2>/dev/null)" = true ]; then
    R_ROOT=$(dirname "$R_COMMON")
    R_NAME=$(basename "$R_ROOT")
  else
    local main
    main=$(dirname "$R_COMMON")
    R_NAME=$(basename "$main")
    R_ROOT="$(dirname "$main")/$R_NAME.worktrees"
  fi
}

repo_roots() {
  if [ -n "${COLLIE_REPO_ROOTS+x}" ]; then
    printf '%s' "$COLLIE_REPO_ROOTS"
  else
    tmux show-options -gqv @collie-repo-roots 2>/dev/null || true
  fi
}

# Prints "name<TAB>dir" for every repo matching the root globs (':'-separated).
discover() {
  local IFS=: pat d roots
  roots=$(repo_roots)
  for pat in $roots; do
    pat=${pat/#\~/$HOME}
    for d in $pat; do
      [ -d "$d/.bare" ] || [ -d "$d/.git" ] || continue
      printf '%s\t%s\n' "$(basename "$d")" "$d"
    done
  done
}

# Resolves "repo[:branch]" into R_* plus SPEC_BRANCH.
resolve_spec() {
  local ref=${1%%:*} dir
  SPEC_BRANCH=""
  [ "$ref" = "$1" ] || SPEC_BRANCH=${1#*:}
  case $ref in
    */* | .* | "~"*) dir=${ref/#\~/$HOME} ;;
    *)
      dir=$(discover | awk -F'\t' -v n="$ref" '$1 == n { print $2; exit }')
      [ -n "$dir" ] || die "unknown repo '$ref' (check @collie-repo-roots)"
      ;;
  esac
  repo_at "$dir" || die "not a git repository: $dir"
}

workspace_repos() {
  local file="$CONFIG_DIR/workspaces" hit
  [ -f "$file" ] || die "unknown workspace '$1' (no $file)"
  hit=$(awk -v w="$1" '/^[[:space:]]*#/ { next } { n = index($0, ":") } n && substr($0, 1, n - 1) == w { print substr($0, n + 1); exit }' "$file")
  [ -n "$hit" ] || die "unknown workspace '$1'"
  printf '%s\n' "$hit"
}

default_base() {
  if git --git-dir="$1" rev-parse -q --verify refs/remotes/origin/HEAD >/dev/null; then
    echo origin/HEAD
  else
    git --git-dir="$1" symbolic-ref -q HEAD
  fi
}

slug() { printf '%s' "${1//\//-}"; }

# --- task files -------------------------------------------------------------

task_dir() { printf '%s/%s' "$TASKS_DIR" "$1"; }

valid_id() {
  local re='^[a-z0-9][a-z0-9-]{0,39}$'
  [[ $1 =~ $re ]]
}

# Task id from argument, else $COLLIE_TASK; must exist.
task_id() {
  local id=${1:-${COLLIE_TASK:-}}
  [ -n "$id" ] || die "no task given (and \$COLLIE_TASK unset)"
  [ -f "$(task_dir "$id")/TASK.md" ] || die "no task '$id'"
  printf '%s' "$id"
}

fm_get() {
  awk -v k="$2" '
    NR == 1 && $0 == "---" { f = 1; next }
    f && $0 == "---" { exit }
    f && index($0, k ":") == 1 { v = substr($0, length(k) + 2); sub(/^ /, "", v); print v; exit }' "$1"
}

fm_set() {
  VAL=$3 awk -v k="$2" '
    BEGIN { v = ENVIRON["VAL"] }
    NR == 1 { print; next }
    !end && $0 == "---" { if (!found) print k ": " v; end = 1; print; next }
    !end && index($0, k ":") == 1 { print k ": " v; found = 1; next }
    { print }' "$1" >"$1.tmp"
  mv "$1.tmp" "$1"
}

log_event() {
  printf '%s\t%s\t%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$2" "${3:-}" >>"$(task_dir "$1")/events.log"
}

write_task_md() { # dir id title status
  local tmpl="$CONFIG_DIR/TASK.md"
  [ -f "$tmpl" ] || tmpl="$PLUGIN_DIR/templates/TASK.md"
  {
    printf -- '---\nid: %s\ntitle: %s\nstatus: %s\npriority: P2\nnext:\ncreated: %s\n---\n' \
      "$2" "$3" "$4" "$(date +%Y-%m-%d)"
    cat "$tmpl"
  } >"$1/TASK.md"
}

# Which task (if any) owns a worktree path.
task_owning() {
  local f
  for f in "$TASKS_DIR"/*/repos.tsv; do
    [ -f "$f" ] || continue
    if awk -F'\t' -v p="$1" '$4 == p { found = 1 } END { exit !found }' "$f"; then
      basename "$(dirname "$f")"
      return
    fi
  done
}

# --- worktree creation (shared by new/add) ----------------------------------

# Creates one worktree; sets CREATED_BRANCH=1 if the branch is new.
add_worktree() { # common path branch from
  local c=$1 p=$2 b=$3 from=$4 base
  CREATED_BRANCH=0
  mkdir -p "$(dirname "$p")" || return 1
  if git --git-dir="$c" show-ref -q --verify "refs/heads/$b"; then
    [ -z "$from" ] || { warn "branch '$b' already exists; --from not applicable"; return 1; }
    git --git-dir="$c" worktree add -q "$p" "$b" </dev/null || return 1
  elif [ -z "$from" ] && git --git-dir="$c" show-ref -q --verify "refs/remotes/origin/$b"; then
    git --git-dir="$c" worktree add -q --track -b "$b" "$p" "origin/$b" </dev/null || return 1
    CREATED_BRANCH=1
  else
    base=${from:-$(default_base "$c")} || { warn "cannot determine default branch; use --from"; return 1; }
    git --git-dir="$c" worktree add -q --no-track -b "$b" "$p" "$base" </dev/null || return 1
    CREATED_BRANCH=1
  fi
}

# Plans, preflights and creates worktrees for SPECS (newline-separated) into
# task <id>; all-or-nothing. Appends to repos.tsv and links on success.
create_repos() { # id default_branch from specs
  local id=$1 default_branch=$2 from=$3 specs=$4 tdir plan="" spec branch path line
  tdir=$(task_dir "$id")

  while IFS= read -r spec; do
    [ -n "$spec" ] || continue
    resolve_spec "$spec"
    branch=${SPEC_BRANCH:-$default_branch}
    path="$R_ROOT/$(slug "$branch")"
    if printf '%s\n' "$plan" | cut -f1 | grep -qxF "$R_NAME" ||
      { [ -f "$tdir/repos.tsv" ] && cut -f1 "$tdir/repos.tsv" | grep -qxF "$R_NAME"; }; then
      die "repo '$R_NAME' is already part of task '$id'"
    fi
    [ ! -e "$path" ] || die "$path already exists"
    line=$(git --git-dir="$R_COMMON" worktree list --porcelain |
      awk -v b="refs/heads/$branch" '/^worktree / { p = substr($0, 10) } $0 == "branch " b { print p; exit }')
    if [ -n "$line" ]; then
      local owner
      owner=$(task_owning "$line")
      [ -z "$owner" ] || owner=" (task '$owner')"
      die "branch '$branch' in $R_NAME is checked out at $line$owner"
    fi
    plan="$plan$R_NAME$TAB$R_COMMON$TAB$branch$TAB$path"$'\n'
  done <<<"$specs"

  local name c b p created=""
  while IFS=$TAB read -r name c b p; do
    [ -n "$name" ] || continue
    if ! add_worktree "$c" "$p" "$b" "$from"; then
      rollback "$created"
      return 1
    fi
    created="$created$c$TAB$p$TAB$b$TAB$CREATED_BRANCH"$'\n'
  done <<<"$plan"

  mkdir -p "$tdir/repos"
  while IFS=$TAB read -r name c b p; do
    [ -n "$name" ] || continue
    printf '%s\t%s\t%s\t%s\n' "$name" "$c" "$b" "$p" >>"$tdir/repos.tsv"
    ln -s "$p" "$tdir/repos/$name"
    ln -s "$tdir" "$p/.collie"
    mkdir -p "$c/info"
    grep -qxF '/.collie' "$c/info/exclude" 2>/dev/null || echo '/.collie' >>"$c/info/exclude"
    log_event "$id" worktree_created "repo=$name branch=$b path=$p"
  done <<<"$plan"
  NEW_PATHS=$(printf '%s' "$plan" | cut -f4)
}

rollback() {
  local c p b cb
  while IFS=$TAB read -r c p b cb; do
    [ -n "$c" ] || continue
    git --git-dir="$c" worktree remove --force "$p" 2>/dev/null || true
    [ "$cb" != 1 ] || git --git-dir="$c" branch -q -D "$b" 2>/dev/null || true
    rmdir "$(dirname "$p")" 2>/dev/null || true
  done <<<"$1"
}

# --- tmux -------------------------------------------------------------------

has_session() { tmux has-session -t "=$1" 2>/dev/null; }

open_window() { # id name path
  local wid
  if has_session "$1"; then
    wid=$(tmux new-window -d -P -F '#{window_id}' -t "=$1:" -n "$2" -c "$3" </dev/null)
  else
    wid=$(tmux new-session -d -P -F '#{window_id}' -s "$1" -n "$2" -c "$3" \
      -e "COLLIE_TASK=$1" -e "COLLIE_TASK_DIR=$(task_dir "$1")" </dev/null)
  fi
  tmux set-option -w -t "$wid" @collie_path "$3"
  tmux set-option -w -t "$wid" @collie_task "$1"
}

ensure_session() {
  local id=$1 name c b p
  has_session "$id" && return 0
  while IFS=$TAB read -r name c b p; do
    if [ -d "$p" ]; then open_window "$id" "$name" "$p"; else warn "missing worktree $p"; fi
  done <"$(task_dir "$id")/repos.tsv"
}

tmux_opt() { tmux show-options -gqv "$1" 2>/dev/null || true; }

# --- agent runtime ----------------------------------------------------------

DEFAULT_PROMPT='Your task contract is .collie/TASK.md. Read it first; if its Objective is empty, ask me what to do.'

# Agent windows as "session<TAB>window<TAB>run<TAB>agent<TAB>state". Agents
# without hooks count as idle after @collie-silence seconds (30) of no output.
win_states() { # list-windows target args
  local silence=${COLLIE_SILENCE:-$(tmux_opt @collie-silence)}
  { tmux list-windows "$@" -F '#{session_name}|#{window_id}|#{@collie_run}|#{@collie_agent}|#{@collie_state}|#{@collie_hooks}|#{window_activity}' 2>/dev/null || true; } |
    awk -F'|' -v now="$(date +%s)" -v s="${silence:-30}" '
      $5 == "" { next }
      { st = $5 }
      st == "working" && $6 == "0" && now - $7 >= s { st = "idle" }
      { print $1 "\t" $2 "\t" ($3 == "" ? "-" : $3) "\t" ($4 == "" ? "-" : $4) "\t" st }'
}

# Runs of a task as "run<TAB>agent<TAB>state<TAB>window": agent windows, then
# runs started but never seen exiting (exited if the session is up, unknown if
# it is gone).
task_runs() {
  local id=$1 wins="" fallback=unknown
  if has_session "$id"; then
    fallback=exited
    wins=$(win_states -t "=$id" | awk -F'\t' '{ print $3 "\t" $4 "\t" $5 "\t" $2 }')
  fi
  [ -z "$wins" ] || printf '%s\n' "$wins"
  printf '%s\n' "$wins" | awk -F'\t' -v fb="$fallback" '
    function kv(k,  a, i, n) {
      n = split($3, a, " ")
      for (i = 1; i <= n; i++) if (index(a[i], k "=") == 1) return substr(a[i], length(k) + 2)
    }
    FNR == NR { seen[$1] = 1; next }
    $2 == "run_started" { r = kv("run"); agent[r] = kv("agent"); order[++n] = r }
    $2 == "run_exited" { ended[kv("run")] = 1 }
    END {
      for (i = 1; i <= n; i++) {
        r = order[i]
        if (!(r in ended) && !(r in seen)) print r "\t" agent[r] "\t" fb "\t-"
      }
    }' - "$(task_dir "$id")/events.log"
}

# Most urgent state among a task's runs, or "-".
agent_summary() {
  task_runs "$1" | awk -F'\t' '
    BEGIN { n = split("waiting idle working exited unknown", o, " "); for (i = 1; i <= n; i++) r[o[i]] = i; b = n + 1; best = "-" }
    ($3 in r) && r[$3] < b { b = r[$3]; best = $3 }
    END { print best }'
}

# @collie-notify / $COLLIE_NOTIFY: on (default), off, or a command that gets
# title and body as arguments.
notify() { # title body
  local how=${COLLIE_NOTIFY-$(tmux_opt @collie-notify)}
  case $how in
    off) ;;
    "" | on)
      if command -v osascript >/dev/null; then
        osascript -e 'on run a' -e 'display notification (item 2 of a) with title (item 1 of a)' -e 'end run' "$1" "$2"
      elif command -v notify-send >/dev/null; then
        notify-send "$1" "$2"
      fi
      ;;
    *) sh -c "$how \"\$1\" \"\$2\"" sh "$1" "$2" ;;
  esac
}

# Records a state change for the window of a pane; ignores non-collie windows.
set_state() { # pane state
  local info id run old wid agent active attached
  info=$(tmux display-message -p -t "$1" '#{@collie_task}|#{@collie_run}|#{@collie_state}|#{window_id}|#{@collie_agent}|#{window_active}|#{session_attached}' 2>/dev/null) || return 0
  IFS='|' read -r id run old wid agent active attached <<<"$info"
  [ -n "$id" ] && [ -f "$(task_dir "$id")/TASK.md" ] || return 0
  [ "$2" != "$old" ] || return 0
  tmux set-option -w -t "$wid" @collie_state "$2" 2>/dev/null || return 0
  log_event "$id" agent_state "run=${run:--} state=$2"
  # no popup for the window you are looking at
  [ "$active" = 1 ] && [ "${attached:-0}" -gt 0 ] && return 0
  case $2:$old in
    waiting:*) notify "collie: $id" "${agent:-agent} is waiting for you" >/dev/null 2>&1 & ;;
    idle:working) notify "collie: $id" "${agent:-agent} finished its turn" >/dev/null 2>&1 & ;;
  esac
}

# --- commands ---------------------------------------------------------------

cmd_new() {
  local id="" specs="" ws="" type=feat title="" from="" status=active edit=0 window=1
  while [ $# -gt 0 ]; do
    case $1 in
      -r) specs="$specs${2:?-r needs a repo}"$'\n'; shift ;;
      -w) ws=${2:?-w needs a workspace}; shift ;;
      -t) type=${2:?-t needs a type}; shift ;;
      --title) title=${2:?--title needs text}; shift ;;
      --from) from=${2:?--from needs a ref}; shift ;;
      --todo) status=todo ;;
      --edit) edit=1 ;;
      --no-window) window=0 ;;
      -*) die "new: unknown option $1" ;;
      *) [ -z "$id" ] || die "new: too many arguments"; id=$1 ;;
    esac
    shift
  done
  [ -n "$id" ] || die "usage: collie new <id> [-r repo[:branch]]... [-w workspace] ..."
  valid_id "$id" || die "invalid id '$id' (use [a-z0-9-], max 40, no leading '-')"
  local tdir r
  tdir=$(task_dir "$id")
  [ ! -e "$tdir" ] || die "task '$id' already exists"
  if [ -n "$ws" ]; then
    for r in $(workspace_repos "$ws"); do specs="$specs$r"$'\n'; done
  fi
  if [ -z "$specs" ]; then
    repo_at . || die "not inside a git repository (use -r or -w)"
    specs="$(pwd -P)"$'\n'
  fi

  if ! create_repos "$id" "$type/$id" "$from" "$specs"; then
    rm -rf "$tdir"
    exit 1
  fi
  write_task_md "$tdir" "$id" "${title:-$id}" "$status"
  log_event "$id" task_created "status=$status"
  [ "$edit" -eq 0 ] || "${EDITOR:-vi}" "$tdir/TASK.md"
  printf '%s\n' "$NEW_PATHS" | head -n 1
  if [ "$window" -eq 1 ] && command -v tmux >/dev/null; then ensure_session "$id"; fi
}

cmd_add() {
  local id="" specs="" from="" window=1
  while [ $# -gt 0 ]; do
    case $1 in
      -r) specs="$specs${2:?-r needs a repo}"$'\n'; shift ;;
      --from) from=${2:?--from needs a ref}; shift ;;
      --no-window) window=0 ;;
      -*) die "add: unknown option $1" ;;
      *) [ -z "$id" ] || die "add: too many arguments"; id=$1 ;;
    esac
    shift
  done
  id=$(task_id "$id")
  [ -n "$specs" ] || die "usage: collie add [<id>] -r repo[:branch]..."
  local branch
  branch=$(head -n 1 "$(task_dir "$id")/repos.tsv" | cut -f3)
  create_repos "$id" "$branch" "$from" "$specs"
  if [ "$window" -eq 1 ] && has_session "$id"; then
    local name c b p
    while IFS=$TAB read -r name c b p; do
      printf '%s\n' "$NEW_PATHS" | grep -qxF "$p" && open_window "$id" "$name" "$p"
    done <"$(task_dir "$id")/repos.tsv"
  fi
}

cmd_ls() {
  local all=0 d id st mark
  [ "${1:-}" != -a ] || all=1
  for d in "$TASKS_DIR"/*; do
    [ -f "$d/TASK.md" ] || continue
    id=$(basename "$d")
    st=$(fm_get "$d/TASK.md" status)
    case $st in done | archived) [ "$all" -eq 1 ] || continue ;; esac
    mark=-
    if has_session "$id"; then mark='*'; fi
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$id" "$st" "$(fm_get "$d/TASK.md" priority)" "$mark" \
      "$(agent_summary "$id")" "$(cut -f1 "$d/repos.tsv" | paste -s -d, -)" "$(fm_get "$d/TASK.md" next)"
  done
}

cmd_show() {
  local id d name c b p mark
  id=$(task_id "${1:-}")
  d=$(task_dir "$id")
  awk 'NR == 1 { next } $0 == "---" { exit } { print }' "$d/TASK.md"
  echo
  echo "repos:"
  while IFS=$TAB read -r name c b p; do
    mark=""
    [ -d "$p" ] || mark=" (missing)"
    printf '  %s\t%s\t%s%s\n' "$name" "$b" "$p" "$mark"
  done <"$d/repos.tsv"
  echo
  echo "runs:"
  task_runs "$id" | sed 's/^/  /'
  echo
  echo "events:"
  tail -n 5 "$d/events.log" | sed 's/^/  /'
}

cmd_go() {
  local id=${1:-}
  if [ -z "$id" ]; then
    command -v fzf >/dev/null || die "go: fzf required when no task is given"
    id=$(cmd_ls | fzf --delimiter='\t' --prompt='task> ' | cut -f1)
    [ -n "$id" ] || exit 1
  fi
  id=$(task_id "$id")
  ensure_session "$id"
  if [ -n "${TMUX:-}" ]; then
    tmux switch-client -t "=$id"
  elif [ -t 1 ]; then
    exec tmux attach-session -t "=$id"
  else
    head -n 1 "$(task_dir "$id")/repos.tsv" | cut -f4
  fi
}

# Shared by done/archive: safety checks, then remove worktrees and session.
finish_task() { # final_status args...
  local final=$1 id="" force=0
  shift
  while [ $# -gt 0 ]; do
    case $1 in
      --force) force=1 ;;
      -*) die "$final: unknown option $1" ;;
      *) [ -z "$id" ] || die "$final: too many arguments"; id=$1 ;;
    esac
    shift
  done
  id=$(task_id "$id")
  local d name c b p problems="" n here own=0
  d=$(task_dir "$id")

  while IFS=$TAB read -r name c b p; do
    [ -d "$p" ] || continue
    [ -z "$(git -C "$p" status --porcelain)" ] || problems="$problems  dirty: $name ($p)"$'\n'
    n=$(git --git-dir="$c" rev-list --count "$(default_base "$c")..refs/heads/$b" 2>/dev/null || echo 0)
    [ "$n" -eq 0 ] || problems="$problems  unmerged: $name has $n commit(s) on $b not in base"$'\n'
  done <"$d/repos.tsv"
  if [ -n "$problems" ] && [ "$force" -eq 0 ]; then
    die "refusing to $final '$id':"$'\n'"$problems"'(branches are kept; --force discards uncommitted changes)'
  fi

  if [ -n "${TMUX:-}" ] && [ "$(tmux display-message -p '#S')" = "$id" ]; then own=1; fi
  here=$(pwd -P)
  if [ "$own" -eq 0 ]; then
    while IFS=$TAB read -r name c b p; do
      case "$here/" in "$p"/*) die "currently inside $p; cd elsewhere first" ;; esac
    done <"$d/repos.tsv"
  fi

  while IFS=$TAB read -r name c b p; do
    rm -f "$d/repos/$name"
    [ -d "$p" ] || continue
    rm -f "$p/.collie"
    if [ "$force" -eq 1 ]; then
      git --git-dir="$c" worktree remove --force "$p"
    else
      git --git-dir="$c" worktree remove "$p"
    fi
    log_event "$id" worktree_removed "repo=$name path=$p"
  done <"$d/repos.tsv"
  fm_set "$d/TASK.md" status "$final"
  log_event "$id" "task_$final" "force=$force"
  if has_session "$id"; then tmux kill-session -t "=$id"; fi
}

cmd_run() {
  local id="" agent="" repo="" prompt=$DEFAULT_PROMPT extra=()
  while [ $# -gt 0 ]; do
    case $1 in
      --agent) agent=${2:?--agent needs a name}; shift ;;
      -r) repo=${2:?-r needs a repo}; shift ;;
      -p) [ $# -ge 2 ] || die "-p needs a prompt"; prompt=$2; shift ;;
      --) shift; extra=("$@"); break ;;
      -*) die "run: unknown option $1" ;;
      *) [ -z "$id" ] || die "run: too many arguments"; id=$1 ;;
    esac
    shift
  done
  id=$(task_id "$id")
  command -v tmux >/dev/null || die "run: tmux required"
  agent=${agent:-${COLLIE_AGENT:-$(tmux_opt @collie-agent)}}
  agent=${agent:-claude}

  local d name c b p rname="" path=""
  d=$(task_dir "$id")
  while IFS=$TAB read -r name c b p; do
    if [ -z "$rname" ] && { [ -z "$repo" ] || [ "$name" = "$repo" ]; }; then rname=$name path=$p; fi
  done <"$d/repos.tsv"
  [ -n "$rname" ] || die "repo '$repo' is not part of task '$id'"
  [ -d "$path" ] || die "missing worktree $path"

  # adapter inputs: other worktrees + the task dir, and the initial prompt
  # shellcheck disable=SC2034
  local RUN_PROMPT=$prompt RUN_DIRS
  # shellcheck disable=SC2034
  RUN_DIRS=$(awk -F'\t' -v p="$path" '$4 != p { print $4 }' "$d/repos.tsv"; printf '%s\n' "$d")
  AGENT_HOOKS=0
  if [[ $agent != */* ]] && [ -f "$PLUGIN_DIR/agents/$agent.sh" ]; then
    # shellcheck source=/dev/null
    . "$PLUGIN_DIR/agents/$agent.sh"
    agent_argv
  else
    AGENT_ARGV=("$agent")
  fi
  command -v "${AGENT_ARGV[0]}" >/dev/null || die "agent command '${AGENT_ARGV[0]}' not found"

  # an agent with hooks and no prompt sits at its input box
  local st=working run wid o
  [ "$AGENT_HOOKS" = 0 ] || [ -n "$prompt" ] || st=idle
  run=$(($(awk -F'\t' '$2 == "run_started" { n++ } END { print n + 0 }' "$d/events.log") + 1))
  ensure_session "$id"
  wid=$(tmux new-window -d -P -F '#{window_id}' -t "=$id:" -n "$agent" -c "$path" \
    "$BASH" "$PLUGIN_DIR/bin/collie" _exec "$id" "$run" "${AGENT_ARGV[@]}" ${extra[@]+"${extra[@]}"} </dev/null)
  for o in "@collie_task=$id" "@collie_path=$path" "@collie_run=$run" "@collie_agent=$agent" \
    "@collie_hooks=$AGENT_HOOKS" "@collie_state=$st"; do
    tmux set-option -w -t "$wid" "${o%%=*}" "${o#*=}"
  done
  # an instant agent exit may log run_exited first; task_runs is order-free
  log_event "$id" run_started "run=$run agent=$agent repo=$rname window=$wid"
  if [ "$(fm_get "$d/TASK.md" status)" = todo ]; then
    fm_set "$d/TASK.md" status active
    log_event "$id" status_changed "status=active"
  fi
}

# Window command of a run: runs the agent, records its exit, leaves a shell.
cmd__exec() { # id run argv...
  local id=$1 run=$2 code=0
  shift 2
  trap : INT
  "$@" || code=$?
  trap - INT
  log_event "$id" run_exited "run=$run code=$code"
  set_state "${TMUX_PANE:-}" exited
  exec "${SHELL:-/bin/sh}"
}

cmd_state() {
  case ${1:-} in
    working | waiting | idle | exited) ;;
    *) die "usage: collie state <working|waiting|idle|exited>" ;;
  esac
  [ -z "${TMUX_PANE:-}" ] || set_state "$TMUX_PANE" "$1"
}

cmd_status() {
  win_states -a | awk -F'\t' '
    { n[$5]++ }
    END {
      if (n["waiting"]) s = s " #[fg=red]●" n["waiting"]
      if (n["idle"]) s = s " #[fg=yellow]●" n["idle"]
      if (n["working"]) s = s " #[fg=green]●" n["working"]
      if (s != "") print substr(s, 2) "#[default]"
    }'
}

cmd_repos() { discover; }

cmd_workspaces() {
  local file="$CONFIG_DIR/workspaces"
  [ -f "$file" ] || return 0
  awk '/^[[:space:]]*(#|$)/ { next } { n = index($0, ":"); v = substr($0, n + 1); sub(/^[[:space:]]+/, "", v); print substr($0, 1, n - 1) "\t" v }' "$file"
}

case "${1:-help}" in
  new | add | ls | show | go | run | state | status | _exec | repos | workspaces)
    cmd=$1
    shift
    "cmd_$cmd" "$@"
    ;;
  "done")
    shift
    finish_task "done" "$@"
    ;;
  archive)
    shift
    finish_task archived "$@"
    ;;
  help | -h | --help) usage ;;
  -v | --version) echo "collie $VERSION" ;;
  *)
    usage >&2
    exit 1
    ;;
esac
