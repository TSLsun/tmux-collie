#!/usr/bin/env bash
# collie — herd coding agents across git worktrees in tmux.
# Bash 3.2 compatible (macOS /bin/bash): no associative arrays, no mapfile.
set -euo pipefail

VERSION=0.4.0
# the usual absolute, clean .../bin/collie needs no cd (forks are slow on macOS)
case ${BASH_SOURCE[0]} in
  /*/bin/collie) PLUGIN_DIR=${BASH_SOURCE[0]%/bin/collie} ;;
  *) PLUGIN_DIR= ;;
esac
case $PLUGIN_DIR in
  "" | *//* | */./* | */../* | */. | */..) PLUGIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)" ;;
esac
STATE_DIR=${COLLIE_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/collie}
TASKS_DIR="$STATE_DIR/tasks"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/collie"
TAB=$'\t'
DASH_PROMPT='collie> ' PICK_MARK='▸ ' SEARCH_PROMPT='filter: ' ASK_MARK='? ' AGENT_MARK='@ ' REVIEW_LABEL=' review '
# a pull/merge request URL, as agents put it in REPORT.md
PR_RE='https?://[^ )>]*/(pull|merge_requests)/[0-9]+'

die() {
  printf 'collie: %s\n' "$*" >&2
  exit 1
}

warn() { printf 'collie: %s\n' "$*" >&2; }

# dies unless an option got a value: need_value run "--agent needs a name" "${2:-}"
need_value() { [ -n "$3" ] || die "$1: $2"; }

# the code lives in lib/: shared helpers, then one file per command group
. "$PLUGIN_DIR/lib/usage.sh"
. "$PLUGIN_DIR/lib/repos.sh"
. "$PLUGIN_DIR/lib/tasks.sh"
. "$PLUGIN_DIR/lib/worktree.sh"
. "$PLUGIN_DIR/lib/tmux.sh"
. "$PLUGIN_DIR/lib/runtime.sh"
. "$PLUGIN_DIR/lib/cmd/tasks.sh"
. "$PLUGIN_DIR/lib/cmd/lifecycle.sh"
. "$PLUGIN_DIR/lib/cmd/agents.sh"
. "$PLUGIN_DIR/lib/cmd/run.sh"
. "$PLUGIN_DIR/lib/cmd/state.sh"
. "$PLUGIN_DIR/lib/cmd/race.sh"
. "$PLUGIN_DIR/lib/cmd/dash.sh"
. "$PLUGIN_DIR/lib/cmd/dash_keys.sh"
. "$PLUGIN_DIR/lib/cmd/dash_pr.sh"
. "$PLUGIN_DIR/lib/cmd/ci.sh"
. "$PLUGIN_DIR/lib/cmd/admin.sh"

# Suggest only an unambiguous near subsequence, including omitted or extra letters.
suggest_command() {
  local input=$1 candidate short long char match='' diff
  [ "${#input}" -ge 2 ] || return 0
  for candidate in $HELP_COMMANDS help; do
    diff=$((${#input} - ${#candidate}))
    [ "$diff" -ge -2 ] && [ "$diff" -le 2 ] || continue
    if [ "$diff" -ge 0 ]; then short=$candidate long=$input
    else short=$input long=$candidate
    fi
    while [ -n "$short" ]; do
      char=${short:0:1}
      short=${short:1}
      case $long in
        *"$char"*) long=${long#*"$char"} ;;
        *) short=$char$short; break ;;
      esac
    done
    [ -z "$short" ] && [ "$diff" -ne 0 ] || continue
    [ -z "$match" ] || return 0
    match=$candidate
  done
  [ -z "$match" ] || printf 'Did you mean: collie %s?\n' "$match" >&2
}

# every cmd_<name> function is the command <name>: adding one needs no list here
[ $# -gt 0 ] || set -- help
case $1 in
  -h | --help) usage ;;
  -v | --version) echo "collie $VERSION" ;;
  *)
    if ! declare -F "cmd_$1" >/dev/null; then
      printf 'collie: unknown command: %s\n' "$1" >&2
      suggest_command "$1"
      printf 'Run collie help for usage.\n' >&2
      exit 1
    fi
    cmd=$1
    shift
    case ${1:-} in -h | --help) cmd_help "$cmd"; exit ;; esac
    "cmd_$cmd" "$@"
    ;;
esac
