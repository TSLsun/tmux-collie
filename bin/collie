#!/usr/bin/env bash
# collie — herd coding agents across git worktrees in tmux.
# Bash 3.2 compatible (macOS /bin/bash): no associative arrays, no mapfile.
set -euo pipefail

VERSION=0.3.0-dev
# the usual absolute, clean .../bin/collie needs no cd (forks are slow on macOS)
case ${BASH_SOURCE[0]} in
  /*/bin/collie) PLUGIN_DIR=${BASH_SOURCE[0]%/bin/collie} ;;
  *) PLUGIN_DIR= ;;
esac
case $PLUGIN_DIR in
  "" | *//* | */./* | */../* | */. | */..) PLUGIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)" ;;
esac
STATE_DIR=${COLLIE_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/collie}
TASKS_DIR="$STATE_DIR/tasks"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/collie"
TAB=$'\t'
DASH_PROMPT='collie> ' PICK_MARK='▸ '
# a pull/merge request URL, as agents put it in REPORT.md
PR_RE='https?://[^ )>]*/(pull|merge_requests)/[0-9]+'
# dashboard keys that run an action without the ? menu; printable keys stay
# for filtering (they take over fzf's ctrl-e end-of-line and ctrl-d delete-char)
DASH_DIRECT='ctrl-r ctrl-v ctrl-e ctrl-d'

die() {
  printf 'collie: %s\n' "$*" >&2
  exit 1
}

warn() { printf 'collie: %s\n' "$*" >&2; }

# the code lives in lib/: shared helpers, then one file per command group
. "$PLUGIN_DIR/lib/usage.sh"
. "$PLUGIN_DIR/lib/repos.sh"
. "$PLUGIN_DIR/lib/tasks.sh"
. "$PLUGIN_DIR/lib/worktree.sh"
. "$PLUGIN_DIR/lib/tmux.sh"
. "$PLUGIN_DIR/lib/runtime.sh"
. "$PLUGIN_DIR/lib/cmd/tasks.sh"
. "$PLUGIN_DIR/lib/cmd/lifecycle.sh"
. "$PLUGIN_DIR/lib/cmd/agents.sh"
. "$PLUGIN_DIR/lib/cmd/dash.sh"
. "$PLUGIN_DIR/lib/cmd/admin.sh"

# every cmd_<name> function is the command <name>: adding one needs no list here
case "${1:-help}" in
  help | -h | --help) usage ;;
  -v | --version) echo "collie $VERSION" ;;
  *)
    if ! declare -F "cmd_$1" >/dev/null; then
      usage >&2
      exit 1
    fi
    cmd=$1
    shift
    "cmd_$cmd" "$@"
    ;;
esac
